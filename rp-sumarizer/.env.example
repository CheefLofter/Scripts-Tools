# Copy to .env and fill in your key.
GEMINI_API_KEY=

# Free-tier-friendly default. Change to any model your key can access.
GEMINI_MODEL=gemini-2.5-flash

# minimal | low | medium | high | xhigh. Leave empty to use the model default.
GEMINI_THINKING_LEVEL=medium

# Keep this modest on the free tier.
GEMINI_MAX_OUTPUT_TOKENS=8192

# Where guides are written. Defaults to ~/Downloads.
PAPERLENS_OUTPUT_DIR=

# One-call limits.
PAPERLENS_MAX_PAPERS=10
PAPERLENS_MAX_TOTAL_MB=12

# Set to 1 for stack traces.
PAPERLENS_DEBUG=0
